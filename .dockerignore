# The 60MB of source photography: the image is built from the normalised
# fixtures in database/demo instead.
/walletImages

/node_modules
/vendor
/.git
/.github
/tests
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/database/database.sqlite
.env
.env.*
!.env.example
/.phpunit.cache
/.worktrees
/.claude

# A symlink created by `artisan storage:link` on the host, pointing at an
# absolute host path that does not exist in the image. Docker's tar writer
# cannot even encode its mode from Windows — "unknown file mode ?rwxr-xr-x" —
# so the build fails before it starts. The entrypoint runs storage:link itself
# on every boot, which makes the link correctly, inside the container.
/public/storage
