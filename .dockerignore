# The 60MB of source photography: the image is built from the normalised
# fixtures in database/demo instead.
/walletImages

/node_modules
/vendor
/.git
/.github
/tests
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/database/database.sqlite
.env
.env.*
!.env.example
/.phpunit.cache
/.worktrees
/.claude

# A symlink created by `artisan storage:link` on the host, pointing at an
# absolute host path that does not exist in the image. Docker's tar writer
# cannot even encode its mode from Windows — "unknown file mode ?rwxr-xr-x" —
# so the build fails before it starts. The entrypoint runs storage:link itself
# on every boot, which makes the link correctly, inside the container.
/public/storage

# Laravel's runtime caches, which are per-environment and must never be baked
# into an image. packages.php and services.php are fine — the build regenerates
# them via package:discover — but config.php and routes-v7.php hold resolved
# values from wherever they were generated. A developer who runs
# `php artisan config:cache` locally and then builds would otherwise ship their
# own APP_KEY and database path to production, and the entrypoint no longer
# overwrites them: it deliberately does not cache config or routes, because
# doing so cost four seconds of every wake-up.
/bootstrap/cache/config.php
/bootstrap/cache/routes-v7.php
/bootstrap/cache/events.php
